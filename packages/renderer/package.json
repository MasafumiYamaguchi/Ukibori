{
  "name": "ukibori-renderer",
  "version": "0.1.0",
  "description": "Backend-agnostic 2.5D renderer core for Ukibori: height-field buffers, CPU/WebGPU backends, and debug buffer export.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:webgpu": "node scripts/test-webgpu.mjs",
    "test:golden": "node scripts/golden-cpu.mjs --verify",
    "goldens:update": "node scripts/golden-cpu.mjs --update",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
